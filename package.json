{
  "name": "agenttoruk",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source AI agents that understand, decide, and solve real-world user issues.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm run generate -w @agenttoruk/database",
    "db:migrate": "npm run migrate -w @agenttoruk/database",
    "db:push": "npm run push -w @agenttoruk/database",
    "db:studio": "npm run studio -w @agenttoruk/database"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.6.2"
}
