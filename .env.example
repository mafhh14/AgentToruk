# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL (default). For MySQL app data, use mysql:// and gemini_file_search for RAG.
DATABASE_URL="postgresql://agenttoruk:agenttoruk@localhost:5432/agenttoruk?schema=public"

# Optional: separate Postgres for pgvector when main DB is MySQL
# VECTOR_DATABASE_URL="postgresql://agenttoruk:agenttoruk@localhost:5432/agenttoruk_vectors?schema=public"

# ─── AI Providers ────────────────────────────────────────────────────────────
DEFAULT_LLM_PROVIDER="openai"
DEFAULT_RAG_PROVIDER="pgvector"

OPENAI_API_KEY=""
GEMINI_API_KEY=""

# ─── App ─────────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production"
NODE_ENV="development"

# ─── Widget ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_REALTIME_URL="http://localhost:3001"

# ─── Realtime (Socket.io) ───────────────────────────────────────────────────
REALTIME_PORT=3001
REALTIME_INTERNAL_URL="http://localhost:3001"
REALTIME_INTERNAL_SECRET="change-me-realtime-secret"
REALTIME_CORS_ORIGIN="http://localhost:3000"
