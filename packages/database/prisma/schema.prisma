generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum MembershipRole {
  OWNER
  ADMIN
  SUPPORT_AGENT
  VIEWER
}

enum LlmProvider {
  OPENAI
  GEMINI
}

enum RagProvider {
  PGVECTOR
  GEMINI_FILE_SEARCH
}

enum ConversationStatus {
  ACTIVE
  ESCALATED
  RESOLVED
  CLOSED
}

enum MessageRole {
  USER
  ASSISTANT
  HUMAN
  SYSTEM
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum KnowledgeDocumentStatus {
  PENDING
  PROCESSING
  INDEXED
  FAILED
}

enum ThemeMode {
  LIGHT
  DARK
  AUTO
}

enum Industry {
  GENERAL
  HOSPITALITY
  TRAVEL
  ECOMMERCE
  SAAS
}

enum MemoryType {
  SHORT_TERM
  LONG_TERM
  PREFERENCE
}

enum WebhookEvent {
  CONVERSATION_CREATED
  MESSAGE_RECEIVED
  TICKET_CREATED
  TICKET_RESOLVED
  HUMAN_HANDOFF_STARTED
}

// ─── Organization & Users ────────────────────────────────────────────────────

model Organization {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  industry         Industry @default(GENERAL)
  industryPackId   String   @default("general-support") @map("industry_pack_id")
  integrationConfig Json?   @map("integration_config")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  memberships       Membership[]
  agentConfig       AgentConfig?
  widgetTheme       WidgetTheme?
  conversations     Conversation[]
  knowledgeDocuments KnowledgeDocument[]
  tickets           Ticket[]
  customerMemories  CustomerMemory[]
  agentLogs         AgentLog[]
  auditEvents       AuditEvent[]
  apiKeys           ApiKey[]
  webhookEndpoints  WebhookEndpoint[]
  workflowRules     WorkflowRule[]

  @@map("organizations")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?  @map("password_hash")
  image        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships    Membership[]
  assignedTickets Ticket[]     @relation("AssignedTickets")
  ticketNotes    TicketNote[]

  @@map("users")
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  userId         String         @map("user_id")
  role           MembershipRole @default(SUPPORT_AGENT)
  createdAt      DateTime       @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("memberships")
}

// ─── Agent Configuration ─────────────────────────────────────────────────────

model AgentConfig {
  id               String      @id @default(cuid())
  organizationId   String      @unique @map("organization_id")
  name             String      @default("Support Agent")
  personality      String?     @db.Text
  tone             String?
  businessDescription String?  @map("business_description") @db.Text
  llmProvider      LlmProvider @default(OPENAI) @map("llm_provider")
  llmModel         String      @default("gpt-4o-mini") @map("llm_model")
  ragProvider      RagProvider @default(PGVECTOR) @map("rag_provider")
  geminiFileSearchStoreId String? @map("gemini_file_search_store_id")
  allowedActions   String[]    @default([]) @map("allowed_actions")
  restrictedActions String[]   @default([]) @map("restricted_actions")
  escalationRules  Json?       @map("escalation_rules")
  workingHours     Json?       @map("working_hours")
  fallbackMessage  String?     @map("fallback_message") @db.Text
  confidenceThreshold Float    @default(0.7) @map("confidence_threshold")
  avatarUrl        String?     @map("avatar_url")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("agent_configs")
}

model WidgetTheme {
  id                   String    @id @default(cuid())
  organizationId       String    @unique @map("organization_id")
  welcomeMessage       String    @default("Hi! How can I help you today?") @map("welcome_message")
  position             String    @default("bottom-right")
  themeMode            ThemeMode @default(AUTO) @map("theme_mode")
  allowUserThemeToggle Boolean   @default(true) @map("allow_user_theme_toggle")
  lightPrimary         String    @default("#2563eb") @map("light_primary")
  lightBackground      String    @default("#ffffff") @map("light_background")
  lightText            String    @default("#1f2937") @map("light_text")
  lightAgentBubble     String    @default("#f3f4f6") @map("light_agent_bubble")
  lightUserBubble      String    @default("#2563eb") @map("light_user_bubble")
  darkPrimary          String    @default("#3b82f6") @map("dark_primary")
  darkBackground       String    @default("#111827") @map("dark_background")
  darkText             String    @default("#f9fafb") @map("dark_text")
  darkAgentBubble      String    @default("#1f2937") @map("dark_agent_bubble")
  darkUserBubble       String    @default("#2563eb") @map("dark_user_bubble")
  fontFamily           String    @default("Inter, system-ui, sans-serif") @map("font_family")
  fontSize             String    @default("md") @map("font_size")
  borderRadius         Int       @default(12) @map("border_radius")
  showPoweredBy        Boolean   @default(true) @map("show_powered_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("widget_themes")
}

// ─── Conversations ───────────────────────────────────────────────────────────

model Conversation {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  status         ConversationStatus @default(ACTIVE)
  visitorName    String?            @map("visitor_name")
  visitorEmail   String?            @map("visitor_email")
  visitorId      String?            @map("visitor_id")
  assignedUserId String?            @map("assigned_user_id")
  summary        String?            @db.Text
  metadata       Json?
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  closedAt       DateTime?          @map("closed_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     Message[]
  rating       ConversationRating?
  tickets      Ticket[]
  agentLogs    AgentLog[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("conversations")
}

model Message {
  id             String      @id @default(cuid())
  conversationId String      @map("conversation_id")
  role           MessageRole
  content        String      @db.Text
  sources        Json?
  metadata       Json?
  confidence     Float?
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model ConversationRating {
  id             String   @id @default(cuid())
  conversationId String   @unique @map("conversation_id")
  score          Int
  feedback       String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("conversation_ratings")
}

// ─── Knowledge Base ──────────────────────────────────────────────────────────

model KnowledgeDocument {
  id             String                  @id @default(cuid())
  organizationId String                  @map("organization_id")
  name           String
  sourceType     String                  @map("source_type")
  sourceUrl      String?                 @map("source_url")
  filePath       String?                 @map("file_path")
  mimeType       String?                 @map("mime_type")
  fileSize       Int?                    @map("file_size")
  status         KnowledgeDocumentStatus @default(PENDING)
  errorMessage   String?                 @map("error_message") @db.Text
  externalId     String?                 @map("external_id")
  externalStoreId String?                @map("external_store_id")
  metadata       Json?
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chunks       KnowledgeChunk[]

  @@index([organizationId, status])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         String                       @id @default(cuid())
  documentId String                       @map("document_id")
  content    String                       @db.Text
  chunkIndex Int                          @map("chunk_index")
  tokenCount Int?                         @map("token_count")
  metadata   Json?
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now()) @map("created_at")

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("knowledge_chunks")
}

// ─── Ticketing ───────────────────────────────────────────────────────────────

model Ticket {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  conversationId String?        @map("conversation_id")
  title          String
  description    String?        @db.Text
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(MEDIUM)
  assigneeId     String?        @map("assignee_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  resolvedAt     DateTime?      @map("resolved_at")
  closedAt       DateTime?      @map("closed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignee     User?        @relation("AssignedTickets", fields: [assigneeId], references: [id], onDelete: SetNull)
  notes        TicketNote[]

  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@map("tickets")
}

model TicketNote {
  id        String   @id @default(cuid())
  ticketId  String   @map("ticket_id")
  authorId  String?  @map("author_id")
  content   String   @db.Text
  isInternal Boolean @default(true) @map("is_internal")
  createdAt DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@map("ticket_notes")
}

// ─── Memory ──────────────────────────────────────────────────────────────────

model CustomerMemory {
  id             String     @id @default(cuid())
  organizationId String     @map("organization_id")
  customerKey    String     @map("customer_key")
  memoryType     MemoryType @map("memory_type")
  key            String
  value          String     @db.Text
  metadata       Json?
  expiresAt      DateTime?  @map("expires_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, customerKey, key])
  @@index([organizationId, customerKey])
  @@map("customer_memories")
}

// ─── Audit & Logs ────────────────────────────────────────────────────────────

model AgentLog {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  conversationId String?  @map("conversation_id")
  stage          String
  input          Json?
  output         Json?
  confidence     Float?
  durationMs     Int?     @map("duration_ms")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("agent_logs")
}

model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  actorId        String?  @map("actor_id")
  action         String
  resource       String
  resourceId     String?  @map("resource_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("audit_events")
}

// ─── API & Webhooks ──────────────────────────────────────────────────────────

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  name           String
  keyHash        String    @unique @map("key_hash")
  keyPrefix      String    @map("key_prefix")
  lastUsedAt     DateTime? @map("last_used_at")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_keys")
}

model WebhookEndpoint {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  url            String
  secret         String
  events         WebhookEvent[]
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  endpointId String   @map("endpoint_id")
  event      WebhookEvent
  payload    Json
  statusCode Int?     @map("status_code")
  response   String?  @db.Text
  success    Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@map("webhook_deliveries")
}

// ─── Workflows ───────────────────────────────────────────────────────────────

model WorkflowRule {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  trigger        String
  conditions     Json
  actions        Json
  isActive       Boolean  @default(true) @map("is_active")
  priority       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive])
  @@map("workflow_rules")
}
